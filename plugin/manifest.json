{
  "id": "com.memomind.muse.connector",
  "name": "MemoMind Muse Connector",
  "version": "0.3.2",
  "entry": "index.html",
  "bridgeVersion": "2.0",
  "schemaVersion": 2,
  "permissionPolicyVersion": 1,
  "permissions": [
    { "name": "audio.capture", "required": true },
    { "name": "audio.playback", "required": false },
    { "name": "display", "required": true },
    { "name": "storage", "required": true },
    {
      "name": "device.events",
      "required": true,
      "scope": { "types": ["button", "imuGesture", "connection"] }
    },
    { "name": "network", "required": true }
  ],
  "deviceRequirements": {
    "preferredPluginId": "com.gm.example.web-bridge",
    "protocols": [
      { "id": "gm.scene", "minVersion": "1.0" },
      { "id": "gm.scene-lz4", "minVersion": "1.0" },
      { "id": "gm.scene-atomic-frame", "minVersion": "1.0" },
      { "id": "gm.device-events", "minVersion": "1.0" }
    ]
  }
}
