# Copy to .env (git-ignored) and fill in. Never commit real keys.

# Anthropic API key for the low-latency Haiku route. Leave blank to fall
# back to the mock LLM (no network calls, canned replies) - handy for a
# first run without any keys set up yet.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# STT_PROVIDER=whisper (default, needs a running whisper.cpp server) | mock
# LLM_PROVIDER=claude (default once ANTHROPIC_API_KEY is set) | mock
# HOST=0.0.0.0 (default, so a phone on the LAN can reach it) | 127.0.0.1

# Local whisper.cpp server (start with: npm run whisper)
WHISPER_URL=http://127.0.0.1:8178
WHISPER_MODEL=base.en

# Dev: save every listening turn's raw Opus to this folder (relative to server/).
RECORD_DIR=../recordings

PORT=8800

# Display name for the Muse-backed assistant persona (HUD label, spoken
# replies, the default wake phrase "ask <name>").
ASSISTANT_NAME=Muse

# Routing: haiku (default, never touches the bridge) | muse (every turn
# goes through the bridge) | wake-phrase (only turns starting with
# ASSISTANT_WAKE_PHRASE go through the bridge, everything else is haiku).
ASSISTANT_ROUTE=haiku
# ASSISTANT_WAKE_PHRASE=ask muse

# Only needed for the muse/wake-phrase routes - see ../bridge/README.md.
# BRIDGE_URL=http://<bridge-tailscale-address>:8900
# BRIDGE_INBOUND_SECRET=
# BACKEND_REPLY_SECRET=
# MUSE_SESSION_ID=
# ASSISTANT_REQUEST_TIMEOUT_MS=25000
