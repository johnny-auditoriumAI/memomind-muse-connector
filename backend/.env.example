# Copy to .env (git-ignored) and fill in. Never commit real keys.

# STT_PROVIDER=whisper (default, needs a running whisper.cpp server) | mock
# HOST=0.0.0.0 (default, so a phone on the LAN can reach it) | 127.0.0.1

# Local whisper.cpp server (start with: npm run whisper)
WHISPER_URL=http://127.0.0.1:8178
WHISPER_MODEL=base.en

# Dev: save every listening turn's raw Opus to this folder (relative to backend/).
RECORD_DIR=../recordings

PORT=8800

# Display name for the Muse-backed assistant persona (HUD label, spoken
# replies).
ASSISTANT_NAME=Muse

# Every turn is routed through the Muse bridge - see ../bridge/README.md for
# the bridge side. Reachable only over Tailscale, never a public address.
BRIDGE_URL=http://<bridge-tailscale-address>:8900
BRIDGE_INBOUND_SECRET=
BACKEND_REPLY_SECRET=
MUSE_SESSION_ID=
# ASSISTANT_REQUEST_TIMEOUT_MS=25000
