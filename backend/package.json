{
  "name": "memomind-muse-connector-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend for the MemoMind Muse Connector glasses plugin: Opus decode, local whisper.cpp STT, streamed Claude replies, optional Muse bridge routing.",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "whisper": "node --env-file-if-exists=.env tools/start-whisper.mjs",
    "decode": "node --env-file-if-exists=.env tools/decode-recording.mjs",
    "replay": "node tools/replay.mjs",
    "smoke": "node smoke-test.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "opusscript": "^0.1.1",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
