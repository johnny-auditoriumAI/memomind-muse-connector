# Copy to /etc/memomind-muse-bridge.env (root:root, mode 0600) and fill in
# real values. Never commit the filled-in version anywhere.

# This Linux host's own Tailscale IP (from `tailscale ip -4`), never 0.0.0.0.
BRIDGE_BIND_HOST=100.x.x.x
BRIDGE_BIND_PORT=8900

# The backend machine's Tailscale hostname or IP, port 8800 (the existing
# Node backend from ../backend).
WINDOWS_BACKEND_URL=http://<backend-tailscale-hostname>:8800

# The dedicated Muse side chat used for assist requests.
MUSE_SESSION_ID=<dedicated-side-chat-id>

# Two SEPARATE generated secrets (e.g. `openssl rand -hex 32`):
#   BRIDGE_INBOUND_SECRET  - required on incoming POST /v1/assist (this file's own inbound auth)
#   BACKEND_REPLY_SECRET   - used by this bridge to authenticate to the backend's POST /v1/muse-reply
BRIDGE_INBOUND_SECRET=
BACKEND_REPLY_SECRET=

REPLY_DIR=/var/lib/memomind-muse-bridge/replies
STATE_DIR=/var/lib/memomind-muse-bridge

# Optional tuning (defaults shown):
# ASSISTANT_NAME=Muse
# HEALTH_INTERVAL_SECONDS=20
# HEALTH_COOLDOWN_SECONDS=120
# HEALTH_TIMEOUT_SECONDS=5
# ASSIST_EXPIRE_SECONDS=600
# REPLY_POLL_INTERVAL_SECONDS=1
# MAX_UTTERANCE_CHARS=2000
# TRANSCRIPT_FORWARDING_ENABLED=false
# MUSE_SIDE_CHAT_SESSION_ID=
